# Database connection (Railway automatically injects DATABASE_URL if PostgreSQL plugin is added)
DATABASE_URL=postgresql://postgres:password@localhost:5432/turnitin_db

# Gemini API Key (Opsional - jika diisi, aplikasi akan menggunakan AI Gemini untuk parafrase)
GEMINI_API_KEY=your_gemini_api_key_here

# Port binding
PORT=8000
HOST=0.0.0.0
